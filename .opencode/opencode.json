{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "./mvnw *": "allow",
      "mvn *": "allow",
      "./gradlew *": "allow",
      "java -jar *": "allow",
      "git *": "allow",
      "git push*": "ask",
      "find *": "allow",
      "cat *": "allow",
      "ls *": "allow"
    }
  },
  "mcp": {
    "intellij-ide": { 
      "type": "remote", 
      "url": "http://localhost:64342/sse", 
      "headers": { 
          "IJ_MCP_SERVER_PROJECT_PATH": "." 
      } 
    },
    "crm-mcp-server": {
      "type": "remote",
      "url": "http://localhost:8080/sse",
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "."
      }
    }
  }
}
