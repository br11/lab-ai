{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "./mvnw *": "allow",
      "mvn *": "allow",
      "./gradlew *": "allow",
      "java -jar *": "allow",
      "git *": "allow",
      "git push*": "ask",
      "find *": "allow",
      "cat *": "allow",
      "ls *": "allow"
    }
  },
  "mcp": {
    "crm-mcp-server": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "enabled": true
    }
  }
}
